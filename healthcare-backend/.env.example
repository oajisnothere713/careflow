# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/healthcare-portal

# Email Configuration (Gmail)
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-gmail-app-password

# Frontend URL
FRONTEND_URL=http://localhost:3000

# Redis Configuration (for Bull queue - reminders)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Optional: For production deployment
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/healthcare-portal
# REDIS_URL=redis://:<password>@<host>:<port>

# Anthropic API (for AI consultation)
ANTHROPIC_API_KEY=your-anthropic-api-key
